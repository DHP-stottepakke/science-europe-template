{#-
  DMP metadata block. Contact people are the contributors whose role choice carries
  the "contactPerson" json.value; the Norwegian model has no separate "creator of
  DMP" role, so the DSW project creator is used for "Created by".
-#}
{%- set contributorItems = replies.administrativeInformation.contributors if replies.administrativeInformation else [] -%}
{%- set contacts = [] -%}
{%- for item in contributorItems -%}
  {%- if item.roles and "contactPerson" in (item.roles|map(attribute='_value')|list) -%}
    {%- do contacts.append(item) -%}
  {%- endif -%}
{%- endfor -%}
<header>
  <p class="dmp"></p>
  <h1>
    {{ dc.project.name }}
  </h1>
  <div class="dmp-info">
    <dl>
      {%- if globals.dmpTitle %}
      <dt>DMP title</dt>
      <dd>{{ globals.dmpTitle }}</dd>
      {%- endif %}

      <dt>Contact {{ "people" if (contacts|length > 1) else "person" }}</dt>
      <dd>
        {%- if contacts|length > 0 -%}
          <ul>
            {%- for contact in contacts -%}
              <li>
                {%- if contact.name and contact.name._value -%}
                  <span class="contact-name">{{ contact.name._value }}</span>
                {%- else -%}
                  <span class="contact-name missing">(name not given)</span>
                {%- endif -%}
                {%- if contact.email and contact.email._value %}
                  <br><a href="mailto:{{ contact.email._value }}">{{ contact.email._value }}</a>
                {%- endif -%}
                {%- if contact.orcid and contact.orcid._value %}
                  <br>{{ contact.orcid._value|markdown }}
                {%- endif -%}
                {%- if contact.affiliation and contact.affiliation._value %}
                  <br>{{ contact.affiliation._value|markdown }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <span class="empty-value">There is no contact person specified yet</span>
        {%- endif -%}
      </dd>

      <dt>Based on</dt>
      <dd>{{ dc.pkg.name }}, {{ dc.pkg.version }} (<span class="package-id"><span class="organization-id">{{ dc.pkg.organization_id }}</span>:<span class="km-id">{{ dc.pkg.km_id }}</span>:<span class="version">{{ dc.pkg.version }}</span></span>)</dd>

      {%- if dc.current_phase and dc.current_phase.title -%}
      <dt>Project phase</dt>
      <dd>{{ dc.current_phase.title }}</dd>
      {%- endif -%}

      <dt>Created by</dt>
      <dd>
        {%- if dc.project.created_by -%}
          {{ dc.project.created_by.first_name }} {{ dc.project.created_by.last_name }}
          {%- if dc.project.created_by.email %}
            <br><a href="mailto:{{ dc.project.created_by.email }}">{{ dc.project.created_by.email }}</a>
          {%- endif -%}
        {%- else -%}
          <span class="empty-value">There is no creator specified yet</span>
        {%- endif -%}
      </dd>

      {% for version in dc.project.versions if version.uuid == ctx.project.versionUuid %}
      <dt>Version</dt>
      <dd>{{version.name}} ({{ version.created_at|datetime_format("%d %b %Y") }})</dd>
      {% endfor %}

      <dt>Generated on</dt>
      <dd>{{ dc.document.created_at|datetime_format("%d %b %Y") }}</dd>
    </dl>
    <p class="note">
      Data Management Plan created in {{ dc.config.service_name }} &laquo;<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_domain_name }}</a>&raquo;
    </p>
  </div>
</header>
